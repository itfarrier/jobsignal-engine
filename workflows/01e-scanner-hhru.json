    {
      "parameters": {
        "jsCode": "// Parse hh.ru RSS items for current feed — title keywords, geography, FNV-1a job IDs\nconst feedItem = $('Loop Over Feeds').item.json;\nif (feedItem._empty) {\n  return [{ json: { _empty: true, _message: 'Empty feed batch' } }];\n}\n\nconst profileData = $('Get Profile').first().json;\nconst geoField = profileData.fields\n  ? profileData.fields['Target Geography']\n  : profileData['Target Geography'];\nconst userGeographies = Array.isArray(geoField) ? geoField : [];\n\nconst GEO_MAP = {\n  Canada: ['canada', 'toronto', 'vancouver', 'montreal', 'ottawa', 'calgary', 'mississauga', 'remote - canada', 'remote canada'],\n  USA: ['united states', 'usa', 'us only', 'remote - us', 'remote us', 'new york', 'san francisco', 'los angeles', 'seattle', 'chicago', 'austin', 'boston'],\n  'Remote Global': ['remote', 'worldwide', 'global', 'anywhere'],\n  'Remote North America': ['remote - north america', 'remote north america', 'remote - na', 'remote us', 'remote canada'],\n  'Remote Canada': ['remote - canada', 'remote canada'],\n  EMEA: ['emea', 'europe', 'london', 'berlin', 'paris', 'amsterdam', 'dublin'],\n  'Remote Europe': ['remote - europe', 'remote europe', 'remote - emea', 'remote emea'],\n  UK: ['united kingdom', 'uk', 'london', 'manchester', 'edinburgh'],\n  Germany: ['germany', 'berlin', 'munich', 'hamburg', 'frankfurt'],\n  Netherlands: ['netherlands', 'amsterdam', 'rotterdam', 'the hague'],\n  France: ['france', 'paris', 'lyon', 'marseille'],\n  Ireland: ['ireland', 'dublin', 'cork'],\n  Australia: ['australia', 'sydney', 'melbourne', 'brisbane'],\n  Singapore: ['singapore'],\n  India: ['india', 'bangalore', 'bengaluru', 'mumbai', 'hyderabad', 'pune', 'delhi', 'gurgaon', 'noida'],\n  APAC: ['apac', 'asia', 'singapore', 'tokyo', 'sydney', 'australia'],\n  'Remote APAC': ['remote - apac', 'remote apac', 'remote - asia', 'remote asia'],\n  'Remote LATAM': ['remote - latam', 'remote latam', 'remote - latin america'],\n  Russia: ['россия', 'russia', 'рф'],\n  Moscow: ['москва', 'moscow', 'мск'],\n  'Saint Petersburg': ['санкт-петербург', 'saint petersburg', 'spb', 'питер'],\n  'Remote Russia': ['удаленно', 'удалённо', 'remote', 'дистанцион'],\n};\n\nconst allowedLocationKeywords = new Set();\nfor (const geo of userGeographies) {\n  const geoKws = GEO_MAP[geo] || [];\n  geoKws.forEach((kw) => allowedLocationKeywords.add(kw));\n}\n\nconst stripHtml = (html) => {\n  if (!html || typeof html !== 'string') return '';\n  let text = html;\n  text = text.split('&lt;').join('<');\n  text = text.split('&gt;').join('>');\n  text = text.split('&quot;').join('\"');\n  text = text.split('&#39;').join(\"'\");\n  text = text.split('&apos;').join(\"'\");\n  text = text.split('&nbsp;').join(' ');\n  text = text.split('&amp;').join('&');\n  let result = '';\n  let inTag = false;\n  for (let i = 0; i < text.length; i++) {\n    const ch = text[i];\n    if (ch === '<') {\n      inTag = true;\n      if (result.length > 0 && result[result.length - 1] !== ' ') result += ' ';\n      continue;\n    }\n    if (ch === '>') {\n      inTag = false;\n      continue;\n    }\n    if (!inTag) result += ch;\n  }\n  return result.replace(/\\s+/g, ' ').trim();\n};\n\nconst parseHhDescription = (stripped) => {\n  const companyMatch = stripped.match(/Вакансия компании:\\s*(.+?)(?=\\s+Создана:|$)/i);\n  const regionMatch = stripped.match(/Регион:\\s*(.+?)(?=\\s+Предполагаемый|$)/i);\n  const salaryMatch = stripped.match(/Предполагаемый уровень месячного дохода:\\s*(.+?)$/i);\n  const company = companyMatch ? companyMatch[1].trim() : 'Unknown';\n  const region = regionMatch ? regionMatch[1].trim() : '';\n  let salaryInfo = '';\n  if (salaryMatch) {\n    const raw = salaryMatch[1].trim();\n    if (raw && !/не\\s+указан/i.test(raw)) salaryInfo = raw;\n  }\n  return { company, region, salaryInfo };\n};\n\nconst matchesGeography = (title, region, description) => {\n  if (allowedLocationKeywords.size === 0) return true;\n  const blob = (title + ' ' + region + ' ' + description).toLowerCase();\n  for (const kw of allowedLocationKeywords) {\n    if (blob.includes(kw)) return true;\n  }\n  return false;\n};\n\nconst titleKeywordsRaw = feedItem.titleKeywords || '';\nconst titleKeywords = titleKeywordsRaw\n  .split(',')\n  .map((k) => k.trim().toLowerCase())\n  .filter((k) => k.length > 0);\n\nconst sourceQuery = feedItem.sourceQuery || '';\nconst sourceTag = feedItem.sourceTag || '';\n\nconst fnv1aHash = (str) => {\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193);\n  }\n  return (hash >>> 0).toString(16).padStart(8, '0');\n};\n\nconst rssItems = $input.all();\nconst seen = new Set();\nconst out = [];\n\nfor (const item of rssItems) {\n  const row = item.json;\n  const title = row.title || '';\n  const applyLink = row.link || '';\n  if (!title || !applyLink) continue;\n\n  if (titleKeywords.length > 0) {\n    const t = title.toLowerCase();\n    if (!titleKeywords.some((kw) => t.includes(kw))) continue;\n  }\n\n  const rawHtml = row.content || row.description || row.contentSnippet || '';\n  const stripped = stripHtml(typeof rawHtml === 'string' ? rawHtml : String(rawHtml));\n  const { company, region, salaryInfo } = parseHhDescription(stripped);\n\n  if (!matchesGeography(title, region, stripped)) continue;\n\n  const hashInput = title + '|' + company + '|' + applyLink;\n  const jobId = fnv1aHash(hashInput) + '-hhr';\n  if (seen.has(jobId)) continue;\n  seen.add(jobId);\n\n  let jobDescription = stripped;\n  if (jobDescription.length > 50000) {\n    jobDescription = jobDescription.substring(0, 50000) + '\\n\\n[Description truncated]';\n  }\n\n  out.push({\n    json: {\n      jobId,\n      jobTitle: title,\n      company,\n      location: region || 'Not specified',\n      applyLink,\n      jobDescription,\n      source: 'hh.ru',\n      sourceQuery,\n      sourceTag,\n      discoveryDate: new Date().toISOString().split('T')[0],\n      salaryInfo,\n    },\n  });\n}\n\nif (out.length === 0) {\n  return [{ json: { _empty: true, _message: 'No jobs passed filters for feed: ' + (sourceQuery || feedItem.feedUrl) } }];\n}\n\nreturn out;"
      },
