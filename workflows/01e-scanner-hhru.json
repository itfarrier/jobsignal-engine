    {
      "parameters": {
        "jsCode": "// Build hh.ru RSS feed URLs from Profile auto-feeds + enabled HH RSS Search Queries\nconst RU_RELEVANT_GEOS = ['Russia', 'Moscow', 'Saint Petersburg', 'Remote Russia'];\nconst VALID_AREAS = new Set(['1', '2', '113']);\n\nconst profileRow = $('Get Profile').first().json;\nconst fields = profileRow.fields || profileRow;\nconst targetRoles = fields['Target Roles'] || [];\nconst coreSkills = fields['Core Skills'] || [];\nconst geoField = fields['Target Geography'];\nconst userGeographies = Array.isArray(geoField) ? geoField : [];\n\nconst hasRuGeo = userGeographies.some((g) => RU_RELEVANT_GEOS.includes(g));\n\nconst buildText = (role, skills) => {\n  const roleStr = String(role || '').trim();\n  const skillParts = (Array.isArray(skills) ? skills : [])\n    .map((s) => String(s || '').trim())\n    .filter((s) => s.length > 0);\n  if (skillParts.length === 0) return roleStr;\n  return [roleStr, ...skillParts].filter(Boolean).join(' OR ');\n};\n\nconst makeFeedUrl = (text, area) =>\n  'https://hh.ru/search/vacancy/rss?text=' + encodeURIComponent(text) + '&area=' + area;\n\nconst resolveArea = (locationRaw, contextLabel) => {\n  if (locationRaw === undefined || locationRaw === null || String(locationRaw).trim() === '') {\n    return hasRuGeo ? '113' : '113';\n  }\n  const area = String(locationRaw).trim();\n  if (!VALID_AREAS.has(area)) {\n    console.log('[01e] Invalid area ID \"' + area + '\" in ' + contextLabel + '; using 113');\n    return '113';\n  }\n  return area;\n};\n\nconst feeds = [];\n\nif (hasRuGeo) {\n  const roles = (Array.isArray(targetRoles) ? targetRoles : []).slice(0, 8);\n  for (const role of roles) {\n    if (!role) continue;\n    const text = buildText(role, coreSkills);\n    if (!text) continue;\n    const area = '113';\n    feeds.push({\n      feedUrl: makeFeedUrl(text, area),\n      sourceQuery: text,\n      sourceTag: 'Profile Auto-feed',\n      titleKeywords: '',\n      areaId: area,\n      feedMeta: { type: 'auto', role: String(role) },\n    });\n  }\n}\n\nfor (const item of $('Get Search Queries').all()) {\n  const row = item.json.fields || item.json;\n  if (item.json._empty) continue;\n\n  let text = String(row['Query String'] || '').trim();\n  const queryLabel = row['Query'] || row['Query Name'] || '';\n  if (!text) {\n    text = String(queryLabel || '').trim();\n    if (!text) continue;\n  }\n\n  const area = resolveArea(row['Location'], 'Search Query \"' + (queryLabel || text) + '\"');\n  const titleKeywords = row['Title Keywords'] || '';\n  const sourceTag = row['Source Tag'] || queryLabel || 'HH RSS';\n\n  feeds.push({\n    feedUrl: makeFeedUrl(text, area),\n    sourceQuery: text,\n    sourceTag,\n    titleKeywords,\n    areaId: area,\n    feedMeta: { type: 'search_query', queryLabel },\n  });\n}\n\nif (feeds.length === 0) {\n  return [{ json: { _empty: true, _message: 'No HH RSS feeds to fetch' } }];\n}\n\nreturn feeds.map((f) => ({ json: f }));"
      },
