    {
      "parameters": {
        "jsCode": "// Filter aggregated jobs against existing Job IDs in Pipeline\nconst aggregatedJobs = $('Aggregate All Jobs').all().filter((item) => !item.json._empty && item.json.jobId);\nconst existingRecords = $('Get Existing Job IDs').all();\n\nconst existingIds = new Set();\nfor (const record of existingRecords) {\n  let jobId = null;\n  if (record.json.fields && record.json.fields['Job ID']) {\n    jobId = record.json.fields['Job ID'];\n  } else if (record.json['Job ID']) {\n    jobId = record.json['Job ID'];\n  }\n  if (jobId) existingIds.add(jobId);\n}\n\nconst netNew = aggregatedJobs.filter((item) => !existingIds.has(item.json.jobId));\n\nif (netNew.length > 100) {\n  throw new Error('Safety brake: ' + netNew.length + ' net-new jobs exceeds 100 limit. Review HH RSS query config.');\n}\n\nif (netNew.length === 0) {\n  return [{ json: { _empty: true, _message: aggregatedJobs.length + ' jobs found, all already in Pipeline' } }];\n}\n\nreturn netNew;"
      },
