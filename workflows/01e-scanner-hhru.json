    {
      "parameters": {
        "jsCode": "// Aggregate results from all feed loops into a single deduplicated list\nconst allItems = $input.all();\nconst realJobs = allItems.filter((item) => !item.json._empty && item.json.jobId);\nconst seen = new Set();\nconst unique = [];\nfor (const item of realJobs) {\n  if (!seen.has(item.json.jobId)) {\n    seen.add(item.json.jobId);\n    unique.push(item);\n  }\n}\nif (unique.length === 0) {\n  return [{ json: { _empty: true, _message: 'No jobs aggregated from HH RSS feeds' } }];\n}\nreturn unique;"
      },
