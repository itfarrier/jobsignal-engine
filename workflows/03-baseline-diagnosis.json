      "parameters": {
        "jsCode": "// Parse n8n execution runData for baseline metrics\n// Logic matches verified parse-runData.mjs from Plan 02\nconst input = $input.first().json;\nconst executionData = input.results?.[0] || input.data?.[0] || input;\nconst runData = executionData.data?.runData || {};\n\nfunction sumRealEntries(nodeName) {\n  const entries = runData[nodeName] || [];\n  return entries.reduce((total, iter) => {\n    const items = iter.output?.[0] || [];\n    const realItems = items.filter(i => !i.json?._empty);\n    return total + realItems.length;\n  }, 0);\n}\n\nfunction sumAllEntries(nodeName) {\n  const entries = runData[nodeName] || [];\n  return entries.reduce((total, iter) => {\n    return total + (iter.output?.[0]?.length || 0);\n  }, 0);\n}\n\nconst feedsGenerated = runData['Build Feed List']?.[0]?.output?.[0]?.length || 0;\nconst totalRssItems = sumRealEntries('RSS Feed Read');\nconst afterGeoFilter = sumRealEntries('Parse & Filter Jobs');\nconst afterDedupOutput = runData['Aggregate All Jobs']?.[0]?.output?.[0] || [];\nconst afterDedup = afterDedupOutput.filter(i => !i.json?._empty).length;\nconst dedupOutput = runData['Deduplicate vs Pipeline']?.[0]?.output?.[0] || [];\nconst netNewPipelineRecords = dedupOutput.filter(i => !i.json?._empty).length;\nconst pipelineRecordsCreated = runData['Create Pipeline Records']?.[0]?.output?.[0]?.length || 0;\nconst errorInfo = executionData.data?.resultData?.error || executionData.error || null;\nconst executionStatus = executionData.status || 'unknown';\nconst feedsGeneratedCount = feedsGenerated;\n\nconst valid = feedsGeneratedCount > 0 && executionStatus !== 'error';\n\nconst perFeedItems = (runData['RSS Feed Read'] || []).map((iter, idx) => ({\n  feedIndex: idx,\n  items: (iter.output?.[0] || []).filter(i => !i.json?._empty).length,\n  total: (iter.output?.[0] || []).length\n}));\n\nconst perFeedAfterGeo = (runData['Parse & Filter Jobs'] || []).map((iter, idx) => ({\n  feedIndex: idx,\n  items: (iter.output?.[0] || []).filter(i => !i.json?._empty).length\n}));\n\nreturn [{\n  json: {\n    executionId: executionData.id,\n    executionStatus,\n    valid,\n    error: errorInfo ? errorInfo.message || JSON.stringify(errorInfo) : null,\n    errorDetails: errorInfo ? JSON.stringify({ message: errorInfo.message, lastNodeExecuted: executionData.lastNodeExecuted }) : null,\n    startedAt: executionData.startedAt,\n    stoppedAt: executionData.stoppedAt,\n    runDurationSeconds: executionData.startedAt && executionData.stoppedAt\n      ? (new Date(executionData.stoppedAt) - new Date(executionData.startedAt)) / 1000 : 0,\n    feedsGenerated: feedsGeneratedCount,\n    totalRssItems,\n    perFeedItems: JSON.stringify(perFeedItems),\n    afterGeoFilter,\n    perFeedAfterGeo: JSON.stringify(perFeedAfterGeo),\n    afterDedup,\n    netNewPipelineRecords,\n    pipelineRecordsCreated\n  }\n}];"
      },
